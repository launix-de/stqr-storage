"""Open a diskless QEMU PXE client for an already running STQR boot gateway."""
import argparse
import ipaddress
import shutil
import re
import secrets
import time
import urllib.error
import urllib.request
from common import boot_network, cli, run


def wait_for_gateway(url, timeout=900):
    deadline = time.monotonic() + timeout
    announced = False
    while True:
        try:
            with urllib.request.urlopen(url, timeout=min(5, max(.1, deadline-time.monotonic()))) as reply:
                if reply.status == 200 and reply.read(4096).startswith(b'#!ipxe'):
                    return
                raise RuntimeError('Boot gateway returned an invalid iPXE script')
        except (OSError, urllib.error.URLError) as error:
            if time.monotonic() >= deadline:
                raise RuntimeError(f'Boot gateway not ready at {url}: {error}. Check the serve terminal.') from None
        if not announced:
            print(f'Waiting for boot gateway at {url}; first startup downloads and prepares the image...', flush=True)
            announced = True
        time.sleep(min(1, max(0, deadline-time.monotonic())))


def mac_address(value):
    if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', value):
        raise argparse.ArgumentTypeError('MAC must contain six colon-separated hex bytes')
    raw = bytes.fromhex(value.replace(':', ''))
    if raw[0] & 1 or not any(raw):
        raise argparse.ArgumentTypeError('MAC must be a nonzero unicast address')
    return value.lower()


def default_mac():
    raw = bytearray(secrets.token_bytes(6))
    raw[0] = (raw[0] | 2) & 0xfe  # Locally administered, unicast.
    return ':'.join(f'{value:02x}' for value in raw)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--server', help='gateway IPv4 address (default: this host on its default-route interface)')
    parser.add_argument('--http-port', type=int, default=8088)
    parser.add_argument('--memory', type=int, default=4096, help='VM memory in MiB')
    parser.add_argument('--mac', type=mac_address, help='stable client MAC (default: unique locally administered address)')
    parser.add_argument('--cpus', type=int, default=2)
    args = parser.parse_args()
    if args.memory < 512 or args.cpus < 1 or not 1 <= args.http_port <= 65535:
        parser.error('memory must be >=512 MiB, CPU count positive, and port valid')
    try:
        server = str(ipaddress.IPv4Address(args.server)) if args.server else boot_network()[1]
    except ValueError as error:
        parser.error(str(error))
    if not shutil.which('qemu-system-x86_64'):
        raise RuntimeError('Missing dependency: qemu-system-x86_64')
    mac = args.mac or default_mac()
    url = f'http://{server}:{args.http_port}/boot.ipxe'
    wait_for_gateway(url)
    print(f'PXE boot from {url}; the gateway selects the published base bucket.', flush=True)
    run('qemu-system-x86_64', '-name', 'STQR PXE test', '-machine', 'accel=kvm:tcg',
        '-m', args.memory, '-smp', args.cpus, '-boot', 'n',
        '-nic', f'user,model=virtio-net-pci,mac={mac},bootfile={url}')


if __name__ == '__main__':
    cli(main)
