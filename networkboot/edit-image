#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
import argparse
import tempfile
from common import cli, ctl, extract, nbd, qemu, require

def main():
    p = argparse.ArgumentParser(description='Boot an existing bucket disk in QEMU; optionally clone before editing')
    p.add_argument('--config', default='stqr.yaml', help='STQR YAML (default: ./stqr.yaml) or private credentials JSON')
    p.add_argument('bucket_name', nargs='?', help='base bucket')
    p.add_argument('--bucket', help=argparse.SUPPRESS)
    p.add_argument('--to-bucket', help='new destination bucket; original remains unchanged')
    p.add_argument('--memory', type=int, default=4096)
    p.add_argument('--cpus', type=int, default=2)
    p.add_argument('--uefi')
    p.add_argument('--kernel-version')
    p.add_argument('--work-dir', default='/var/tmp', help='local archive staging directory; needs disk space')
    args = p.parse_args()
    if args.bucket_name and args.bucket:
        p.error('specify the bucket only once')
    args.bucket = args.bucket_name or args.bucket
    if not args.bucket:
        p.error('bucket name required')
    require('qemu-system-x86_64', 'guestfish', 'sort')
    ctl(args.config, 'check-exclusive', args.bucket)
    if args.memory<512 or args.cpus<1:
        p.error("memory must be at least 512 MiB and CPU count positive")
    target = args.to_bucket or args.bucket
    if args.to_bucket:
        ctl(args.config, 'create', target)
        ctl(args.config, 'clone', args.bucket, target)
    with tempfile.TemporaryDirectory(prefix='stqr-edit-', dir=args.work_dir) as work:
        with nbd(args.config, target, work) as socket:
            qemu(socket, args)
            extract(socket, work, args.kernel_version)
        ctl(args.config, 'publish', target, work)
        ctl(args.config, 'gc', target)
    print('Published', target)

if __name__ == '__main__':
    cli(main)
