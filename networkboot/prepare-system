#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
import argparse
import subprocess
from pathlib import Path
from common import (cli, ctl, extract, nbd, qemu, require, staging,
                    prepared_release, remember_preparation, forget_preparation,
                    installed_disk, remember_installation, forget_installation,
                    temporary_installation_name)

def main():
    p = argparse.ArgumentParser(description='Install a Linux VM directly on a bucket-backed NBD disk, then publish its rootfs')
    p.add_argument('--config', default='stqr.yaml', help='STQR YAML (default: ./stqr.yaml) or private credentials JSON')
    p.add_argument('bucket_name', nargs='?', help='rootfs bucket name; without ISO, finish preparing an existing installation')
    p.add_argument('image', nargs='?', type=Path, help='installer ISO')
    p.add_argument('--bucket', help=argparse.SUPPRESS)
    p.add_argument('--install-image', type=Path, help=argparse.SUPPRESS)
    p.add_argument('--disk-gib', type=int, default=32)
    p.add_argument('--memory', type=int, default=4096)
    p.add_argument('--cpus', type=int, default=2)
    p.add_argument('--uefi', help='optional OVMF firmware file; also pass it when editing')
    p.add_argument('--kernel-version')
    p.add_argument('--publish-only', action='store_true', help='prepare and publish the existing installation disk without starting QEMU or needing an ISO')
    p.add_argument('--resume', action='store_true', help='reuse an unpublished installation disk after an interrupted installation')
    p.add_argument('--work-dir', default='/var/tmp', help='local archive staging directory; needs disk space')
    args = p.parse_args()
    if args.bucket_name and args.bucket:
        p.error('specify the bucket only once')
    args.bucket = args.bucket_name or args.bucket
    if not args.bucket:
        p.error('bucket name required')
    if args.image and args.install_image:
        p.error('specify the install image only once')
    args.install_image = args.image or args.install_image
    args.publish_only = args.publish_only or not args.install_image
    if args.resume and args.publish_only:
        p.error('--resume requires an installer ISO; omit it to publish the installed system')
    prepared = prepared_release(args.config, args.bucket) if args.publish_only and not args.kernel_version else None
    require(*([] if prepared else ['guestfish', 'sort', 'lsinitramfs']),
            *([] if args.publish_only else ['qemu-system-x86_64']))
    ctl(args.config, 'check-exclusive', args.bucket)
    if args.memory<512 or args.cpus<1:
        p.error("memory must be at least 512 MiB and CPU count positive")
    if (not args.publish_only and not args.install_image.is_file()) or args.disk_gib <= 0:
        p.error('a local installer image and positive disk size are required')
    disk = installed_disk(args.config, args.bucket)
    if args.resume or (args.publish_only and not prepared and not disk):
        # The installation device has an explicit, predictable name. Never
        # rename the published filesystem or reinterpret it as a blockdevice.
        disk = disk or temporary_installation_name(args.bucket)
        ctl(args.config, '--size', str(args.disk_gib << 30), 'check-install-disk', disk)
        remember_installation(args.config, args.bucket, disk)
    elif not args.publish_only:
        if disk:
            p.error('an unfinished temporary installation exists; use --resume')
        disk = temporary_installation_name(args.bucket)
        ctl(args.config, 'create', disk)
        remember_installation(args.config, args.bucket, disk)
        ctl(args.config, '--size', str(args.disk_gib << 30), 'init-disk', disk)
    options = {'existing': prepared['work']} if prepared else {}
    with staging(args.work_dir, 'stqr-prepare-', **options) as work:
        if not prepared:
            with nbd(args.config, disk, work) as socket:
                if not args.publish_only:
                    qemu(socket, args, args.install_image)
                print('Preparing networkboot release from the installed disk...', flush=True)
                extract(socket, work, args.kernel_version, args.config)
            remember_preparation(args.config, args.bucket, work)
        else:
            print('Resuming prepared image', args.bucket, flush=True)
        if not prepared or prepared['phase'] != 'published' or prepared.get('image_layout') != 2:
            print('Uploading and publishing networkboot release...', flush=True)
            ctl(args.config, 'publish', args.bucket, work)
            remember_preparation(args.config, args.bucket, work, 'published')
        print('Published', args.bucket, flush=True)
        try:
            if disk:
                if disk != temporary_installation_name(args.bucket):
                    raise RuntimeError('refusing to delete the published image as an installation disk')
                ctl(args.config, 'delete', disk)
                forget_installation(args.config, args.bucket)
        except subprocess.CalledProcessError:
            raise RuntimeError(f'Image {args.bucket} is published, but temporary installation disk cleanup failed. Retry: networkboot/prepare-system {args.bucket}') from None
    forget_preparation(args.config, args.bucket)
    print('Cleanup complete', flush=True)

if __name__ == '__main__':
    cli(main)
