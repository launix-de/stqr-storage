#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
manual_add_modules kstqr
copy_exec /usr/lib/stqr-networkboot/boot-root /bin/stqr-boot-root
copy_exec /sbin/mount.kstqr /bin/mount.kstqr
# MODULES=most includes network drivers for physical boot clients.
