#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Used by the offline mkinitramfs hook and the pre-PID1 boot script. The marker
# records completed image preparation, not a runtime object/payload cache. Only
# the tiny marker is read from STQR; payload hashing reads initramfs RAM.
stqr_login_assets() {
    printf '%s\n' "lib/modules/$1/extra/kstqr.ko" \
        usr/lib/stqr-networkboot/login.json \
        usr/lib/stqr-networkboot/install-login \
        usr/lib/stqr-networkboot/pam_stqr.so \
        usr/lib/stqr-networkboot/home-template.json \
        usr/libexec/stqr-home usr/libexec/stqr-bootctl
}
stqr_login_manifest() {
    printf '%s\n' '# STQR prepared boot assets v1'
    stqr_login_assets "$2" | while IFS= read -r stqr_login_manifest_asset; do
        (cd "${1:-/}" && sha256sum "$stqr_login_manifest_asset") || exit 1
    done
}
stqr_login_install() {
    chroot "$1" /usr/bin/python3 /usr/lib/stqr-networkboot/install-login \
        /usr/lib/stqr-networkboot/login.json --server "$2"
}
# /run itself is noexec. A dedicated child mount keeps the payload executable,
# root-only and local, then becomes readonly before any file is bound into root.
# initramfs-tools moves /run (including child mounts) into the final root after
# init-bottom, so these sources survive run-init deleting the old initramfs.
stqr_login_mount() { mount "$@"; }
stqr_login_bind_changes() {
    stqr_bind_root=$1 stqr_bind_payload=$2 stqr_bind_list=$3 stqr_bind_run=$4
    [ -s "$stqr_bind_list" ] || return 0
    stqr_bind_ram=$(mktemp -d "$stqr_bind_run/stqr-boot-assets.XXXXXX") || return 1
    stqr_login_mount -t tmpfs -o size=64m,mode=0700,nodev,nosuid,exec stqr-boot-assets "$stqr_bind_ram" || return 1
    while IFS= read -r stqr_bind_asset; do
        mkdir -p "$stqr_bind_ram/$(dirname "$stqr_bind_asset")" || return 1
        cp -p "$stqr_bind_payload/$stqr_bind_asset" "$stqr_bind_ram/$stqr_bind_asset" || return 1
    done < "$stqr_bind_list"
    stqr_login_mount -t tmpfs -o remount,ro,nodev,nosuid,exec stqr-boot-assets "$stqr_bind_ram" || return 1
    while IFS= read -r stqr_bind_asset; do
        stqr_bind_target="$stqr_bind_root/$stqr_bind_asset"
        mkdir -p "$(dirname "$stqr_bind_target")" || return 1
        if [ ! -e "$stqr_bind_target" ]; then
            (umask 077; : > "$stqr_bind_target") || return 1
        fi
        # Helpers have regular file leaves; merged-/usr directory links remain
        # supported. Refuse an unexpected leaf link or special device target.
        [ -f "$stqr_bind_target" ] && [ ! -L "$stqr_bind_target" ] || return 1
        stqr_login_mount --bind "$stqr_bind_ram/$stqr_bind_asset" "$stqr_bind_target" || return 1
        # Give both paths explicitly: BusyBox otherwise searches /proc/mounts
        # for the literal target, which fails for /lib -> usr/lib aliases.
        stqr_login_mount -o remount,bind,ro,nodev,nosuid,exec "$stqr_bind_ram/$stqr_bind_asset" "$stqr_bind_target" || return 1
    done < "$stqr_bind_list"
}
stqr_prepare_login() {
    stqr_login_root=$1 stqr_login_server=$2 stqr_login_kernel=$3 stqr_login_payload=${4:-/} stqr_login_run=${5:-/run}
    stqr_login_marker=usr/lib/stqr-networkboot/prepared.sha256
    stqr_login_current=$(mktemp "$stqr_login_run/stqr-login.XXXXXX") || return 1
    stqr_login_changes=$(mktemp "$stqr_login_run/stqr-login-changes.XXXXXX") || { rm -f "$stqr_login_current"; return 1; }
    stqr_login_manifest "$stqr_login_payload" "$stqr_login_kernel" > "$stqr_login_current" || { rm -f "$stqr_login_current" "$stqr_login_changes"; return 1; }
    if ! cmp -s "$stqr_login_current" "$stqr_login_root/$stqr_login_marker"; then
        # A stale/missing image marker needs runtime overrides, not megabytes
        # of copy-up into STQR. Only identity/config changes reach the upper.
        stqr_login_reinstall=0
        if ! grep -qx '# STQR prepared boot assets v1' "$stqr_login_root/$stqr_login_marker" 2>/dev/null; then
            stqr_login_reinstall=1
        fi
        while IFS= read -r stqr_login_line; do
            case "$stqr_login_line" in '# '*) continue;; esac
            stqr_login_asset=${stqr_login_line#*  }
            if ! grep -Fqx "$stqr_login_line" "$stqr_login_root/$stqr_login_marker" 2>/dev/null; then
                case "$stqr_login_asset" in
                    */home-template.json)
                        # install-login regenerates this OUTPUT atomically.
                        # A readonly file bind here makes os.replace fail EBUSY
                        # when the login/home plan changes. Keep its tiny
                        # generated metadata on the writable guest upper.
                        stqr_login_reinstall=1
                        continue;;
                    */login.json|*/install-login) stqr_login_reinstall=1;;
                esac
                printf '%s\n' "$stqr_login_asset" >> "$stqr_login_changes"
            fi
        done < "$stqr_login_current"
        stqr_login_bind_changes "$stqr_login_root" "$stqr_login_payload" "$stqr_login_changes" "$stqr_login_run" || { rm -f "$stqr_login_current" "$stqr_login_changes"; return 1; }
        if [ "$stqr_login_reinstall" = 1 ]; then
            stqr_login_install "$stqr_login_root" "$stqr_login_server" || { rm -f "$stqr_login_current" "$stqr_login_changes"; return 1; }
        fi
        # Never advance the persistent prepared marker for RAM-only overrides.
        # An edited image/reused upper must bind them again on its next boot.
    fi
    rm -f "$stqr_login_current" "$stqr_login_changes"
    "$stqr_login_payload/bin/stqr-boot-root" --login-uri "$stqr_login_root" "$stqr_login_server"
}
