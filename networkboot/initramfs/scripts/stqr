#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
prereqs() { :; }
case "$1" in prereqs) prereqs; exit 0;; esac
mountroot() {
    . /scripts/functions
    configure_networking
    stqr_server=""
    stqr_port=2049
    stqr_release=""
    stqr_upper_port=""
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            stqr.server=*) stqr_server=${arg#*=} ;;
            stqr.upper-port=*) stqr_upper_port=${arg#*=} ;;
            stqr.release=*) stqr_release=${arg#*=} ;;
            stqr.nfsport=*) stqr_port=${arg#*=} ;;
        esac
    done
    [ -n "$stqr_server" ] || panic "STQR boot server missing"
    case "$stqr_release" in *[!0-9a-f]*|"") panic "Invalid STQR release" ;; esac
    [ "${#stqr_release}" = 64 ] || panic "Invalid STQR release length"
    modprobe nfs
    modprobe overlay
    modprobe squashfs
    modprobe loop
    mkdir -p /run/stqr/lower /run/stqr/export /run/stqr/ram "$rootmnt"
    mount -t nfs -o "ro,vers=3,proto=tcp,port=$stqr_port,mountport=$stqr_port,mountproto=tcp,nolock,noacl" "$stqr_server:/$stqr_release" /run/stqr/export || panic "STQR NFS root failed"
    mount -t squashfs -o loop,ro /run/stqr/export/rootfs.squashfs /run/stqr/lower || panic "STQR root image failed"
    if [ -n "$stqr_upper_port" ]; then
        modprobe nbd nbds_max=4 max_part=0
        modprobe ext4
        /bin/stqr-nbd-client "$stqr_server" "$stqr_upper_port" /dev/nbd0 --root-storage || panic "STQR upper connection failed"
        /sbin/mkfs.ext4 -q -F /dev/nbd0 || panic "STQR upper format failed"
        mount -t ext4 /dev/nbd0 /run/stqr/ram || panic "STQR upper mount failed"
    else
        mount -t tmpfs -o mode=0700 tmpfs /run/stqr/ram || panic "STQR temporary upper failed"
    fi
    mkdir -p /run/stqr/ram/upper /run/stqr/ram/work
    mount -t overlay overlay -o lowerdir=/run/stqr/lower,upperdir=/run/stqr/ram/upper,workdir=/run/stqr/ram/work "$rootmnt" || panic "STQR root overlay failed"
    # Each boot gets its own identity and host keys; the readonly base is shared.
    : > "$rootmnt/etc/machine-id"
    rm -f "$rootmnt/var/lib/dbus/machine-id" "$rootmnt/var/lib/systemd/random-seed"
    rm -f "$rootmnt"/etc/ssh/ssh_host_*_key "$rootmnt"/etc/ssh/ssh_host_*_key.pub
    mkdir -p "$rootmnt/etc/systemd/system/ssh.service.d"
    printf '[Service]\nExecStartPre=/usr/bin/ssh-keygen -A\n' > "$rootmnt/etc/systemd/system/ssh.service.d/stqr.conf"
}
